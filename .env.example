# Copie para `.env` (ou rode `pnpm env:init`, que gera senhas aleatórias).
# Nunca versione o `.env` (§44.4).

# ── PostgreSQL / Redis (Docker Compose) ───────────────────────────────
POSTGRES_PASSWORD=troque-esta-senha
# Publicadas apenas no loopback para o desenvolvimento no host (§44.6).
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── API (apps/api) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://tech_lead_hub:troque-esta-senha@127.0.0.1:5432/tech_lead_hub
# Banco separado, recriado pelos testes de integração.
DATABASE_URL_TEST=postgresql://tech_lead_hub:troque-esta-senha@127.0.0.1:5432/tech_lead_hub_test
HOST=127.0.0.1
PORT=4000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# `true` quando a web for servida por HTTPS (nuvem, §44.7).
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Planning worker (apps/planning-worker) ─────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=2

# ── Web (apps/web) ─────────────────────────────────────────────────────
API_INTERNAL_URL=http://127.0.0.1:4000
