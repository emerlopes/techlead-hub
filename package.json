{
  "name": "tech-lead-hub",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tlh/shared-contracts build && pnpm --parallel --filter \"./apps/*\" --filter @tlh/shared-contracts dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @tlh/api test:integration",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @tlh/api db:migrate",
    "db:deploy": "pnpm --filter @tlh/api db:deploy",
    "db:studio": "pnpm --filter @tlh/api db:studio",
    "env:init": "node infrastructure/scripts/init-env.mjs"
  }
}
