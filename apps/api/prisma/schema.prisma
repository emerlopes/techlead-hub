// Fundação técnica (Etapa 1, §54): identidade, sessão, workspace e auditoria.
// Convenções (§35): UUID nas entidades, timestamptz para instantes, `version` para
// controle otimista nas entidades mutáveis, nomes físicos em snake_case.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  /// Fuso explícito usado em calendários e datas de negócio (§35.3).
  timezone  String   @db.VarChar(64)
  locale    String   @default("pt-BR") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(1)

  users       User[]
  auditEvents AuditEvent[]
  teams       Team[]
  projects    Project[]
  developers  Developer[]
  tasks       Task[]
  focusQueue  FocusQueueItem[]

  externalSources ExternalSource[]
  workItems       ExternalWorkItem[]
  sprints         Sprint[]
  releases        Release[]
  risks           Risk[]
  journalEntries  JournalEntry[]

  workSchedules          WorkSchedule[]
  availabilityExceptions AvailabilityException[]
  capacityAllocations    CapacityAllocation[]

  @@map("workspaces")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  name             String    @db.VarChar(80)
  email            String    @unique @db.VarChar(254)
  /// Hash Argon2id em formato PHC (§44.2). Nunca a senha.
  passwordHash     String    @map("password_hash")
  /// Único usuário proprietário (§44.1): a constraint impede um segundo setup concorrente.
  isOwner          Boolean   @unique @default(true) @map("is_owner")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int       @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sessions  Session[]

  @@index([workspaceId])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 do token opaco do cookie; o token em si nunca é persistido.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

/// Trilha de auditoria (§34.18, RNF-022). Somente inserção.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Organização e gestão pessoal (Etapa 2, §54): times, projetos, desenvolvedores,
// associações (§9), atividades pessoais e fila de foco (§6).
// ---------------------------------------------------------------------------

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum DeveloperStatus {
  ACTIVE
  INACTIVE
}

enum TaskType {
  TECHNICAL
  FOLLOW_UP
  DECISION
  MEETING
  PLANNING
  REVIEW
  INVESTIGATION
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Team {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  name        String     @db.VarChar(80)
  /// Único por workspace (§7.4, RN-015).
  code        String     @db.VarChar(12)
  description String?    @db.VarChar(500)
  status      TeamStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int        @default(1)

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projects   TeamProject[]
  developers TeamDeveloper[]
  tasks      TaskTeam[]

  sprints      Sprint[]
  trackings    DeliveryTracking[]
  riskLinks    RiskLink[]
  journalLinks JournalLink[]

  allocations CapacityAllocation[]

  @@unique([workspaceId, code])
  @@map("teams")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  name        String        @db.VarChar(80)
  /// Único por workspace (§8.5, RN-015).
  code        String        @db.VarChar(12)
  description String?       @db.VarChar(500)
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int           @default(1)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  teams     TeamProject[]
  tasks     TaskProject[]

  workItems    ExternalWorkItem[]
  releases     Release[]
  riskLinks    RiskLink[]
  journalLinks JournalLink[]

  allocations CapacityAllocation[]

  @@unique([workspaceId, code])
  @@map("projects")
}

/// Participação de um time em um projeto (§9.1). Encerrar preserva o histórico (RN-025).
model TeamProject {
  id        String    @id @default(uuid()) @db.Uuid
  teamId    String    @map("team_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  isPrimary Boolean   @default(false) @map("is_primary")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([teamId])
  @@index([projectId])
  @@map("team_projects")
}

model Developer {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  name            String          @db.VarChar(80)
  email           String?         @db.VarChar(254)
  roleDescription String?         @map("role_description") @db.VarChar(120)
  status          DeveloperStatus @default(ACTIVE)
  notes           String?         @db.VarChar(2000)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int             @default(1)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  teams     TeamDeveloper[]
  trackings DeliveryTracking[]

  schedules   WorkSchedule[]
  exceptions  AvailabilityException[]
  allocations CapacityAllocation[]

  @@index([workspaceId, status])
  @@map("developers")
}

/// Participação de um desenvolvedor em um time (§9.3). Mudanças de time preservam histórico.
model TeamDeveloper {
  id          String    @id @default(uuid()) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  developerId String    @map("developer_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  developer Developer @relation(fields: [developerId], references: [id], onDelete: Restrict)

  @@index([teamId])
  @@index([developerId])
  @@map("team_developers")
}

/// Atividade pessoal do Tech Lead (§6). Domínio separado das entregas dos times (§3.2).
model Task {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  title          String       @db.VarChar(200)
  description    String?      @db.VarChar(5000)
  type           TaskType     @default(OTHER)
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  /// Data de negócio (§35.3), interpretada no fuso do workspace.
  dueDate        DateTime?    @map("due_date") @db.Date
  nextAction     String?      @map("next_action") @db.VarChar(300)
  blockedReason  String?      @map("blocked_reason") @db.VarChar(500)
  estimatedHours Decimal?     @map("estimated_hours") @db.Decimal(7, 2)
  actualHours    Decimal?     @map("actual_hours") @db.Decimal(7, 2)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)
  cancelledAt    DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int          @default(1)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  teams     TaskTeam[]
  projects  TaskProject[]
  focus     FocusQueueItem?
  workItems TaskWorkItem[]
  riskLinks RiskLink[]

  @@index([workspaceId, status, dueDate])
  @@map("tasks")
}

/// Vínculo atividade ↔ time: a atividade continua única (§6.8).
model TaskTeam {
  taskId String @map("task_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@id([taskId, teamId])
  @@index([teamId])
  @@map("task_teams")
}

model TaskProject {
  taskId    String @map("task_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@id([taskId, projectId])
  @@index([projectId])
  @@map("task_projects")
}

/// Fila de foco (§6.6): até três atividades (RN-003), no máximo um foco principal (RN-002).
model FocusQueueItem {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  taskId      String  @unique @map("task_id") @db.Uuid
  position    Int
  isPrimary   Boolean @default(false) @map("is_primary")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, position])
  @@map("focus_queue_items")
}

// ---------------------------------------------------------------------------
// Acompanhamento de entregas (Etapa 3, §54): itens externos (§13), acompanhamento
// (§14), sprints (§11), releases (§12), refinamentos (§15), riscos e impedimentos
// (§16) e diário de bordo (§17). O item externo é a raiz do agregado: acompanhamento
// e refinamento compartilham a `version` dele.
// ---------------------------------------------------------------------------

enum WorkItemType {
  STORY
  BUG
  TECHNICAL_TASK
  SPIKE
  IMPROVEMENT
  OTHER
}

/// Execução do item (§13.4). Independente do refinamento (RN-007).
enum ExecutionStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

/// §15.3.
enum RefinementStatus {
  NEEDS_REFINEMENT
  ANALYZING
  WAITING_INFORMATION
  READY
  CANCELLED
}

/// Avaliação manual de saúde (§14.4). A saúde calculada não é persistida: é derivada na leitura.
enum HealthStatus {
  ON_TRACK
  AT_RISK
  DELAYED
  BLOCKED
  UNKNOWN
}

/// De onde veio a informação de situação (§14.3 `status_source`).
enum StatusSource {
  TECH_LEAD
  DEVELOPER
  EXTERNAL_TOOL
  MEETING
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
  CANCELLED
}

/// §11.5: original, adicionado, remanejado.
enum SprintScopeType {
  ORIGINAL
  ADDED
  MOVED
}

enum SprintExitReason {
  COMPLETED
  NOT_COMPLETED
  MOVED
  REMOVED
}

enum ReleaseStatus {
  PLANNED
  IN_PROGRESS
  RELEASED
  CANCELLED
}

enum RiskType {
  RISK
  IMPEDIMENT
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskProbability {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  OPEN
  MONITORING
  RESOLVED
  CANCELLED
}

/// Impedimento bloqueia total ou parcialmente uma entrega (§16.4).
enum BlockingLevel {
  FULL
  PARTIAL
}

/// §17.2.
enum JournalCategory {
  TECH_DECISION
  INCIDENT
  BLOCK
  UNBLOCK
  LEARNING
  SCOPE_CHANGE
  ACHIEVEMENT
  RISK
  GENERAL
}

/// Ferramenta externa de origem dos itens (Jira, Azure DevOps…). Referência, não integração (§13.6).
model ExternalSource {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(60)
  baseUrl     String?  @map("base_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int      @default(1)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  workItems ExternalWorkItem[]

  @@unique([workspaceId, name])
  @@map("external_sources")
}

/// História, bug ou tarefa de uma ferramenta externa (§13). A ferramenta continua sendo a fonte (§13.2).
model ExternalWorkItem {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  sourceId         String           @map("source_id") @db.Uuid
  /// Único por origem (RN-005).
  externalKey      String           @map("external_key") @db.VarChar(60)
  title            String           @db.VarChar(300)
  externalUrl      String?          @map("external_url") @db.VarChar(2000)
  itemType         WorkItemType     @default(STORY) @map("item_type")
  /// Projeto de referência (RN-018).
  projectId        String           @map("project_id") @db.Uuid
  executionStatus  ExecutionStatus  @default(NOT_STARTED) @map("execution_status")
  refinementStatus RefinementStatus @default(NEEDS_REFINEMENT) @map("refinement_status")
  notes            String?          @db.VarChar(5000)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int              @default(1)

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  source             ExternalSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tracking           DeliveryTracking?
  refinement         Refinement?
  sprintMemberships  SprintMembership[]
  releaseMemberships ReleaseMembership[]
  tasks              TaskWorkItem[]
  riskLinks          RiskLink[]
  journalLinks       JournalLink[]
  estimates          EffortEstimate[]

  @@unique([sourceId, externalKey])
  @@index([workspaceId, projectId])
  @@index([workspaceId, executionStatus])
  @@map("external_work_items")
}

/// Acompanhamento corrente do item (§14.3); um por item na versão inicial (§14.5).
model DeliveryTracking {
  id                   String        @id @default(uuid()) @db.Uuid
  workItemId           String        @unique @map("work_item_id") @db.Uuid
  executingTeamId      String?       @map("executing_team_id") @db.Uuid
  developerId          String?       @map("developer_id") @db.Uuid
  /// Datas de negócio (§35.3). Compromisso e previsão separados (§12.5).
  committedDate        DateTime?     @map("committed_date") @db.Date
  manualForecastDate   DateTime?     @map("manual_forecast_date") @db.Date
  /// Avaliação manual; a calculada fica separada para não perder informação (§14.4).
  healthStatus         HealthStatus? @map("health_status")
  remainingEffortHours Decimal?      @map("remaining_effort_hours") @db.Decimal(7, 2)
  lastCheckedAt        DateTime?     @map("last_checked_at") @db.Timestamptz(3)
  statusSource         StatusSource? @map("status_source")
  statusNote           String?       @map("status_note") @db.VarChar(1000)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workItem      ExternalWorkItem          @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  executingTeam Team?                     @relation(fields: [executingTeamId], references: [id], onDelete: Restrict)
  developer     Developer?                @relation(fields: [developerId], references: [id], onDelete: Restrict)
  history       DeliveryTrackingHistory[]

  @@index([executingTeamId])
  @@index([developerId])
  @@map("delivery_trackings")
}

/// Fotografia do acompanhamento após cada mudança relevante (RN-006, CA-006). Somente inserção.
model DeliveryTrackingHistory {
  id                   String           @id @default(uuid()) @db.Uuid
  deliveryTrackingId   String           @map("delivery_tracking_id") @db.Uuid
  changedAt            DateTime         @default(now()) @map("changed_at") @db.Timestamptz(3)
  actorUserId          String?          @map("actor_user_id") @db.Uuid
  changedFields        String[]         @map("changed_fields")
  executionStatus      ExecutionStatus  @map("execution_status")
  refinementStatus     RefinementStatus @map("refinement_status")
  executingTeamId      String?          @map("executing_team_id") @db.Uuid
  developerId          String?          @map("developer_id") @db.Uuid
  committedDate        DateTime?        @map("committed_date") @db.Date
  manualForecastDate   DateTime?        @map("manual_forecast_date") @db.Date
  healthStatus         HealthStatus?    @map("health_status")
  remainingEffortHours Decimal?         @map("remaining_effort_hours") @db.Decimal(7, 2)
  statusNote           String?          @map("status_note") @db.VarChar(1000)

  tracking DeliveryTracking @relation(fields: [deliveryTrackingId], references: [id], onDelete: Cascade)

  @@index([deliveryTrackingId, changedAt])
  @@map("delivery_tracking_history")
}

/// Vínculo atividade pessoal ↔ item externo (§6.8): concluir um não resolve o outro.
model TaskWorkItem {
  taskId     String @map("task_id") @db.Uuid
  workItemId String @map("work_item_id") @db.Uuid

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workItem ExternalWorkItem @relation(fields: [workItemId], references: [id], onDelete: Restrict)

  @@id([taskId, workItemId])
  @@index([workItemId])
  @@map("task_work_items")
}

/// Ciclo de execução de um time (§11). Pode conter histórias de vários projetos (RN-019).
model Sprint {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  /// Time responsável (RN-016).
  teamId      String       @map("team_id") @db.Uuid
  name        String       @db.VarChar(80)
  goal        String?      @db.VarChar(1000)
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime     @map("end_date") @db.Date
  status      SprintStatus @default(PLANNED)
  closedAt    DateTime?    @map("closed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int          @default(1)

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  team              Team               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  memberships       SprintMembership[]
  intendedRefinings Refinement[]
  riskLinks         RiskLink[]
  journalLinks      JournalLink[]

  @@index([teamId, startDate])
  @@index([workspaceId, status])
  @@map("sprints")
}

/// Participação de um item em uma sprint (§11.5). Sair registra `exited_at`; nada é apagado (RN-010).
model SprintMembership {
  id         String            @id @default(uuid()) @db.Uuid
  sprintId   String            @map("sprint_id") @db.Uuid
  workItemId String            @map("work_item_id") @db.Uuid
  enteredAt  DateTime          @default(now()) @map("entered_at") @db.Timestamptz(3)
  exitedAt   DateTime?         @map("exited_at") @db.Timestamptz(3)
  scopeType  SprintScopeType   @map("scope_type")
  exitReason SprintExitReason? @map("exit_reason")

  sprint   Sprint           @relation(fields: [sprintId], references: [id], onDelete: Restrict)
  workItem ExternalWorkItem @relation(fields: [workItemId], references: [id], onDelete: Restrict)

  @@index([sprintId])
  @@index([workItemId])
  @@map("sprint_memberships")
}

/// Entrega planejada de um projeto (§12). Pode reunir itens de vários times (CA-008).
model Release {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  /// Um projeto na versão inicial (RN-017).
  projectId     String        @map("project_id") @db.Uuid
  name          String        @db.VarChar(80)
  description   String?       @db.VarChar(2000)
  committedDate DateTime?     @map("committed_date") @db.Date
  /// Previsão manual; a calculada chega com o motor de previsibilidade (§25).
  forecastDate  DateTime?     @map("forecast_date") @db.Date
  status        ReleaseStatus @default(PLANNED)
  closedAt      DateTime?     @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  version       Int           @default(1)

  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project         Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  memberships     ReleaseMembership[]
  milestones      ReleaseMilestone[]
  forecastHistory ReleaseForecastHistory[]
  riskLinks       RiskLink[]
  journalLinks    JournalLink[]

  @@index([projectId])
  @@index([workspaceId, status])
  @@map("releases")
}

/// Item no escopo de uma release (§12.4). Remover registra `removed_at` (histórico de escopo).
model ReleaseMembership {
  id         String    @id @default(uuid()) @db.Uuid
  releaseId  String    @map("release_id") @db.Uuid
  workItemId String    @map("work_item_id") @db.Uuid
  isRequired Boolean   @default(true) @map("is_required")
  addedAt    DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(3)

  release  Release          @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  workItem ExternalWorkItem @relation(fields: [workItemId], references: [id], onDelete: Restrict)

  @@index([releaseId])
  @@index([workItemId])
  @@map("release_memberships")
}

/// Marco intermediário de uma release (§12.2, §34.9).
model ReleaseMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  releaseId   String    @map("release_id") @db.Uuid
  name        String    @db.VarChar(120)
  targetDate  DateTime? @map("target_date") @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@map("release_milestones")
}

/// Compromisso e previsão da release após cada alteração (§12.5). Somente inserção.
model ReleaseForecastHistory {
  id            String    @id @default(uuid()) @db.Uuid
  releaseId     String    @map("release_id") @db.Uuid
  changedAt     DateTime  @default(now()) @map("changed_at") @db.Timestamptz(3)
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  committedDate DateTime? @map("committed_date") @db.Date
  forecastDate  DateTime? @map("forecast_date") @db.Date

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, changedAt])
  @@map("release_forecast_history")
}

/// Preparação do item antes da execução (§15). A situação fica no item (`refinement_status`).
model Refinement {
  id                   String   @id @default(uuid()) @db.Uuid
  workItemId           String   @unique @map("work_item_id") @db.Uuid
  intendedSprintId     String?  @map("intended_sprint_id") @db.Uuid
  openQuestions        String?  @map("open_questions") @db.VarChar(2000)
  pendingItems         String?  @map("pending_items") @db.VarChar(2000)
  notes                String?  @db.VarChar(2000)
  /// Justificativa para "pronto" com checklist incompleto (§15.5).
  readyExceptionReason String?  @map("ready_exception_reason") @db.VarChar(1000)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workItem       ExternalWorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  intendedSprint Sprint?               @relation(fields: [intendedSprintId], references: [id], onDelete: Restrict)
  checkItems     RefinementCheckItem[]

  @@index([intendedSprintId])
  @@map("refinements")
}

/// Item do checklist de prontidão (§15.4). `checked_at` preenchido = atendido.
model RefinementCheckItem {
  id           String    @id @default(uuid()) @db.Uuid
  refinementId String    @map("refinement_id") @db.Uuid
  label        String    @db.VarChar(120)
  position     Int
  checkedAt    DateTime? @map("checked_at") @db.Timestamptz(3)

  refinement Refinement @relation(fields: [refinementId], references: [id], onDelete: Cascade)

  @@index([refinementId, position])
  @@map("refinement_check_items")
}

/// Risco ou impedimento (§16). Resolvido continua no histórico (RN-008).
model Risk {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  title          String           @db.VarChar(200)
  description    String?          @db.VarChar(5000)
  type           RiskType         @default(RISK)
  severity       RiskSeverity     @default(MEDIUM)
  probability    RiskProbability?
  impact         String?          @db.VarChar(1000)
  blockingLevel  BlockingLevel?   @map("blocking_level")
  status         RiskStatus       @default(OPEN)
  mitigationPlan String?          @map("mitigation_plan") @db.VarChar(2000)
  /// Responsável pelo acompanhamento: pode ser alguém de fora do cadastro.
  owner          String?          @db.VarChar(120)
  identifiedAt   DateTime         @map("identified_at") @db.Date
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)
  resolutionNote String?          @map("resolution_note") @db.VarChar(1000)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int              @default(1)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  links        RiskLink[]
  journalLinks JournalLink[]

  @@index([workspaceId, status])
  @@map("risks")
}

/// Contexto afetado por um risco: exatamente uma referência por linha (CHECK na migration).
model RiskLink {
  id         String  @id @default(uuid()) @db.Uuid
  riskId     String  @map("risk_id") @db.Uuid
  workItemId String? @map("work_item_id") @db.Uuid
  sprintId   String? @map("sprint_id") @db.Uuid
  releaseId  String? @map("release_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid
  teamId     String? @map("team_id") @db.Uuid
  taskId     String? @map("task_id") @db.Uuid

  risk     Risk              @relation(fields: [riskId], references: [id], onDelete: Cascade)
  workItem ExternalWorkItem? @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  sprint   Sprint?           @relation(fields: [sprintId], references: [id], onDelete: Restrict)
  release  Release?          @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  project  Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  team     Team?             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  task     Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([riskId, workItemId])
  @@unique([riskId, sprintId])
  @@unique([riskId, releaseId])
  @@unique([riskId, projectId])
  @@unique([riskId, teamId])
  @@unique([riskId, taskId])
  @@index([workItemId])
  @@index([sprintId])
  @@index([releaseId])
  @@index([projectId])
  @@index([teamId])
  @@map("risk_links")
}

/// Acontecimento do diário de bordo (§17). Categoria e descrição obrigatórias (§17.4).
model JournalEntry {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  category    JournalCategory
  description String          @db.VarChar(5000)
  /// Preenchida com hoje no fuso do workspace, ajustável (§17.4).
  occurredOn  DateTime        @map("occurred_on") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int             @default(1)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  links     JournalLink[]

  @@index([workspaceId, occurredOn])
  @@map("journal_entries")
}

/// Contexto de um acontecimento: exatamente uma referência por linha (CHECK na migration).
model JournalLink {
  id         String  @id @default(uuid()) @db.Uuid
  entryId    String  @map("entry_id") @db.Uuid
  teamId     String? @map("team_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid
  sprintId   String? @map("sprint_id") @db.Uuid
  releaseId  String? @map("release_id") @db.Uuid
  workItemId String? @map("work_item_id") @db.Uuid
  riskId     String? @map("risk_id") @db.Uuid

  entry    JournalEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  team     Team?             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  project  Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sprint   Sprint?           @relation(fields: [sprintId], references: [id], onDelete: Restrict)
  release  Release?          @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  workItem ExternalWorkItem? @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  risk     Risk?             @relation(fields: [riskId], references: [id], onDelete: Restrict)

  @@unique([entryId, teamId])
  @@unique([entryId, projectId])
  @@unique([entryId, sprintId])
  @@unique([entryId, releaseId])
  @@unique([entryId, workItemId])
  @@unique([entryId, riskId])
  @@index([teamId])
  @@index([projectId])
  @@index([sprintId])
  @@index([releaseId])
  @@index([workItemId])
  @@index([riskId])
  @@map("journal_links")
}

// ---------------------------------------------------------------------------
// Capacidade (Etapa 4, §54): jornadas e calendários (§19), ausências, alocações entre
// times e projetos (§20) e estimativas (§21). Capacidade e demanda são derivadas na leitura
// por funções puras (`capacity-rules.ts`); nada calculado é persistido.
// ---------------------------------------------------------------------------

/// §19.3.
enum AvailabilityExceptionType {
  VACATION
  DAY_OFF
  HOLIDAY
  TRAINING
  ABSENCE
  EXTRA_SUPPORT
  OTHER
}

/// §20.3.
enum AllocationType {
  PERCENTAGE
  HOURS
}

/// Periodicidade explícita das alocações em horas (§20.3).
enum AllocationPeriod {
  DAY
  WEEK
}

/// §21.4.
enum EstimateConfidence {
  HIGH
  MEDIUM
  LOW
}

/// Jornada de trabalho de uma pessoa por período de vigência (§19.1). Vigências não se sobrepõem
/// (EXCLUDE na migration); mudar a jornada encerra a anterior, preservando o histórico.
model WorkSchedule {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  developerId   String    @map("developer_id") @db.Uuid
  validFrom     DateTime  @map("valid_from") @db.Date
  validUntil    DateTime? @map("valid_until") @db.Date
  timezone      String    @db.VarChar(64)
  /// Horas por dia da semana, de segunda (0) a domingo (6). `weekly_hours` é a soma, derivada.
  weeklyPattern Decimal[] @map("weekly_pattern") @db.Decimal(4, 2)
  /// Fator de foco entre 0 e 1, aplicado após os descontos (RN-028). Não mede produtividade (§18.4).
  focusFactor   Decimal   @map("focus_factor") @db.Decimal(3, 2)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version       Int       @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  developer Developer @relation(fields: [developerId], references: [id], onDelete: Restrict)

  @@index([developerId, validFrom])
  @@map("work_schedules")
}

/// Indisponibilidade de uma pessoa ou, sem pessoa, feriado do calendário do workspace (§19.2).
/// Cancelar preserva o registro (`cancelled_at`).
model AvailabilityException {
  id               String                    @id @default(uuid()) @db.Uuid
  workspaceId      String                    @map("workspace_id") @db.Uuid
  /// `null` = feriado que vale para todas as pessoas (calendário do workspace).
  developerId      String?                   @map("developer_id") @db.Uuid
  type             AvailabilityExceptionType
  startDate        DateTime                  @map("start_date") @db.Date
  endDate          DateTime                  @map("end_date") @db.Date
  /// Horas indisponíveis por dia; `null` = dia inteiro. Nunca desconta mais que a jornada do dia.
  unavailableHours Decimal?                  @map("unavailable_hours") @db.Decimal(4, 2)
  /// Motivo genérico, sem informação pessoal sensível (§19.4, §44.5).
  description      String?                   @db.VarChar(200)
  cancelledAt      DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int                       @default(1)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  developer Developer? @relation(fields: [developerId], references: [id], onDelete: Restrict)

  @@index([developerId, startDate])
  @@index([workspaceId, startDate])
  @@map("availability_exceptions")
}

/// Parcela da capacidade efetiva de uma pessoa reservada para um time, um projeto, os dois ou,
/// sem nenhum, uma reserva geral (§20). Não representa horas trabalhadas (§20.5, RN-036).
model CapacityAllocation {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  developerId     String            @map("developer_id") @db.Uuid
  teamId          String?           @map("team_id") @db.Uuid
  projectId       String?           @map("project_id") @db.Uuid
  allocationType  AllocationType    @map("allocation_type")
  /// Percentual entre 0 e 1 (§35.7) ou horas por `period`.
  allocationValue Decimal           @map("allocation_value") @db.Decimal(7, 4)
  period          AllocationPeriod?
  validFrom       DateTime          @map("valid_from") @db.Date
  validUntil      DateTime?         @map("valid_until") @db.Date
  description     String?           @db.VarChar(300)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int               @default(1)

  workspace Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  developer Developer                   @relation(fields: [developerId], references: [id], onDelete: Restrict)
  team      Team?                       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  project   Project?                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  history   CapacityAllocationHistory[]

  @@index([developerId, validFrom])
  @@index([teamId])
  @@index([projectId])
  @@map("capacity_allocations")
}

/// Fotografia da alocação após cada mudança (§20.5 "preservar histórico", RN-038). Somente inserção.
model CapacityAllocationHistory {
  id              String            @id @default(uuid()) @db.Uuid
  allocationId    String            @map("allocation_id") @db.Uuid
  changedAt       DateTime          @default(now()) @map("changed_at") @db.Timestamptz(3)
  actorUserId     String?           @map("actor_user_id") @db.Uuid
  changedFields   String[]          @map("changed_fields")
  teamId          String?           @map("team_id") @db.Uuid
  projectId       String?           @map("project_id") @db.Uuid
  allocationType  AllocationType    @map("allocation_type")
  allocationValue Decimal           @map("allocation_value") @db.Decimal(7, 4)
  period          AllocationPeriod?
  validFrom       DateTime          @map("valid_from") @db.Date
  validUntil      DateTime?         @map("valid_until") @db.Date

  allocation CapacityAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([allocationId, changedAt])
  @@map("capacity_allocation_history")
}

/// Estimativa de esforço de um item (§21). Cada revisão é uma nova linha (RN-030, CA-022).
model EffortEstimate {
  id             String             @id @default(uuid()) @db.Uuid
  workItemId     String             @map("work_item_id") @db.Uuid
  estimatedHours Decimal            @map("estimated_hours") @db.Decimal(7, 2)
  remainingHours Decimal            @map("remaining_hours") @db.Decimal(7, 2)
  confidence     EstimateConfidence
  /// Referência adicional; nunca convertida em horas (§21.5).
  storyPoints    Decimal?           @map("story_points") @db.Decimal(5, 1)
  /// Esforço realizado, opcional e informado manualmente (§21.3).
  actualHours    Decimal?           @map("actual_hours") @db.Decimal(7, 2)
  reason         String?            @db.VarChar(500)
  estimatedAt    DateTime           @default(now()) @map("estimated_at") @db.Timestamptz(3)
  actorUserId    String?            @map("actor_user_id") @db.Uuid

  workItem ExternalWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId, estimatedAt])
  @@map("effort_estimates")
}
