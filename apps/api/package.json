{
  "name": "@tlh/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && nest start --watch --preserveWatchOutput",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "prisma generate && vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@tlh/shared-contracts": "workspace:*",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.10.0",
    "@tlh/config": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9",
    "pg": "^8.23.1",
    "prisma": "~7.10.0",
    "supertest": "^7.1.0",
    "typescript": "~5.9.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^4.1.0"
  }
}
